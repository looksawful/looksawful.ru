{
  "name": "vanila-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "desk": "npm run media:ensure && node tools/run-content-desk.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "cms:generate": "node tools/generate-pages-cms-options.mjs",
    "cms:check": "node tools/generate-pages-cms-options.mjs --check",
    "media:catalog:sync": "node tools/sync-media-catalog.mjs",
    "media:catalog:check": "node tools/sync-media-catalog.mjs --check",
    "media:dedupe:check": "node tools/media/check-dedupe-integrity.mjs",
    "media:dedupe:physical": "node tools/media/audit-physical-duplicates.mjs",
    "media:sync": "npm run media:catalog:sync && npm run media:video:build && npm run media:build && node tools/media-dev-state.mjs --write",
    "media:ensure": "npm run media:catalog:sync && node tools/media-dev-state.mjs --ensure",
    "media:prepare": "npm run media:sync",
    "build:vite": "vite build",
    "build:site": "npm run cms:check && npm run build:vite && npm run site:postbuild",
    "build:core": "npm run typecheck && npm run build:site",
    "build": "npm run build:site",
    "cv:content:apply": "node tools/apply-cv-content.mjs",
    "site:postbuild": "npm run cv:content:apply && node tools/generate-sitemap.mjs && node tools/check-site-meta.mjs && node tools/check-local-links.mjs",
    "check:site-meta": "node tools/check-site-meta.mjs",
    "check:links": "node tools/check-local-links.mjs",
    "check:external-links": "node tools/check-external-links.mjs",
    "check:production": "node tools/check-production.mjs",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "lighthouse": "lhci autorun",
    "media:build": "node tools/build-responsive-media.mjs",
    "media:video": "node tools/build-video-media.mjs",
    "media:video:build": "node tools/build-video-media.mjs --build",
    "preview": "vite preview",
    "test:core": "node --test && node tools/check-data-integrity.ts",
    "test": "npm run test:fast",
    "test:fast": "node tools/ci/run-tests.mjs fast",
    "test:unit": "node tools/ci/run-tests.mjs unit",
    "test:ci": "node tools/ci/run-tests.mjs ci",
    "test:cv": "node tools/ci/run-tests.mjs cv",
    "test:media:contract": "node tools/ci/run-tests.mjs media-contract && node tools/check-data-integrity.ts",
    "test:media:checks": "node tools/ci/run-tests.mjs media && node tools/check-data-integrity.ts && npm run media:dedupe:check",
    "test:media": "npm run media:sync && npm run test:media:checks",
    "test:e2e": "node tools/smoke-site.mjs",
    "test:e2e:navigation": "node tools/smoke-site-navigation.mjs",
    "test:e2e:mpa": "node tools/smoke-mpa.mjs",
    "test:e2e:projects": "node tools/smoke-project-pages.mjs",
    "test:e2e:cv": "node tools/smoke-cv.mjs",
    "test:e2e:full": "node tools/e2e/run-all.mjs",
    "test:e2e:smoke": "node tools/e2e/run-smoke.mjs",
    "test:e2e:affected": "node tools/e2e/run-affected.mjs",
    "test:e2e:media-desk": "node tools/e2e/run-media-desk.mjs",
    "test:e2e:production": "node tools/e2e/run-production.mjs",
    "test:e2e:cv:production": "node tools/e2e/run-cv-production.mjs",
    "verify:core": "npm run typecheck && npm run test:core && npm run build:site && npm run test:e2e:full",
    "verify": "npm run media:ensure && npm run typecheck && npm run test:fast && npm run test:media:contract && npm run build:site && npm run test:e2e:smoke",
    "verify:full": "npm run media:sync && npm run verify:core",
    "quality:dependency-audit": "npm audit --audit-level=high",
    "quality:external-links": "node tools/check-external-links.mjs",
    "quality:health": "node tools/check-production-health.mjs",
    "quality:lighthouse": "node tools/run-lighthouse-production.mjs",
    "cv:prod:prepare": "node tools/prepare-cv-production.mjs",
    "cv:prod:verify": "node tools/verify-cv-production.mjs"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@typescript/typescript6": "^6.0.2",
    "playwright": "^1.61.1",
    "sharp": "^0.34.5",
    "typescript": "^7.0.2",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "@egjs/infinitegrid": "^4.13.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/rubik": "5.3.0",
    "embla-carousel": "8.6.0",
    "gsap": "^3.15.0",
    "photoswipe": "5.4.4",
    "photoswipe-dynamic-caption-plugin": "1.2.7",
    "split.js": "^1.6.5",
    "three": "^0.184.0",
    "tom-select": "^2.6.2"
  },
  "engines": {
    "node": "24.x"
  }
}