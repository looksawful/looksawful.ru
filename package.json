{
  "name": "vanila-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/media/dev-media.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "media:test": "node --test tools/media/tests/media-core.test.mjs",
    "media:audit": "node tools/media/migrate-media.mjs",
    "media:migrate": "node tools/media/migrate-media.mjs --apply",
    "media:verify": "node tools/media/verify-media-system.mjs --mode build",
