    "media:bootstrap": "node tools/media/bootstrap-media-sources.mjs --apply",
    "media:prepare": "node tools/media/prepare-media.mjs",
    "media:watch": "node tools/media/watch-media.mjs",
    "media:annotate:check": "node tools/media/annotate-media-items.mjs",
