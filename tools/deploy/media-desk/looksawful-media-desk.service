[Unit]
Description=looksawful Media Desk
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=looksawful
Group=looksawful
WorkingDirectory=/srv/looksawful.ru
EnvironmentFile=/etc/looksawful/media-desk.env
ExecStart=/usr/bin/npm run desk:network
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/looksawful.ru

[Install]
WantedBy=multi-user.target
