# Non-secret runtime configuration
PORT=8080
HOST=0.0.0.0
UPSTREAM_TIMEOUT_MS=120000
ALLOWED_ORIGINS=https://looksawful.ru

# Store actual values in Yandex Lockbox. Never commit them.
AWFUL_INTERNAL_TOKEN=
OPENAI_API_KEY=
YANDEX_AI_API_KEY=

# Optional model defaults
OPENAI_MODEL=
YANDEX_AI_MODEL=gpt://<folder-id>/yandexgpt/latest

# Provider endpoints
OPENAI_BASE_URL=https://api.openai.com/v1
YANDEX_AI_BASE_URL=https://ai.api.cloud.yandex.net/v1

# Yandex Cloud resource IDs. These are identifiers, not credentials.
YC_CLOUD_ID=
YC_FOLDER_ID=
YC_SERVICE_ACCOUNT_ID=
YC_STORAGE_BUCKET=
