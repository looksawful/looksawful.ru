{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "looksawful.ru"
        }
      ],
      "destination": "https://www.looksawful.ru/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/pet-projects/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/resume/:path*",
      "destination": "/index.html"
    }
  ]
}

